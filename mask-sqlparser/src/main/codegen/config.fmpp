data: {
  parser: {
    # Generated parser implementation package and class name.
    package: "io.sqlmask.parser",
    class: "SqlMaskParserImpl",

    # 本覆盖层的每个键都是整键替换（与上游 Calcite 构建语义一致：
    # 模块 config 键整体覆盖 default_config 键）。因此凡 babel
    # config.fmpp 有原值的键，这里必须放「babel 原值 + mask 新增项」
    # 的合并结果，见 EXTENSIONS.md「Babel base」一节。

    # List of files in @includes directory.
    # babel 原值（parserImpls.ftl、parserPostgresImpls.ftl）+ mask 新增
    # （maskParserImpls.ftl，自有产生式 SqlMaskInsertOverwrite / SqlMaskTopN）。
    implementationFiles: [
      "parserImpls.ftl"
      "parserPostgresImpls.ftl"
      "maskParserImpls.ftl"
    ],

    # mask 扩展关键字（INSERT OVERWRITE，spec §4.3；SELECT TOP，spec §4.2）
    # + babel 原有关键字（支撑 LEFT SEMI/ANTI JOIN、CREATE TABLE
    # [IF NOT EXISTS]/[VOLATILE] 及 postgres 产生式）。
    keywords: [
      # babel 原值
      "ANTI"
      "DISCARD"
      "IF"
      "PLANS"
      "SEED"
      "SEMI"
      "SEQUENCES"
      "SNAPSHOT"
      "TEMP"
      "VOLATILE"
      # mask 新增
      "TOP"
      "OVERWRITE"
    ],

    # 覆盖层整键替换：此处放 babel 全量非保留字表 + mask 新增 TOP/OVERWRITE
    # （保持非保留，避免破坏其作为标识符的既有用法）。INT/INTEGER 在 babel
    # 词表中为非保留关键字——CONVERT(int, id) 因此走 Oracle 标识符分支
    # 而非 MSSQL DataType 分支，unparse 输出与 SqlBabelParserImpl 一致。
    nonReservedKeywordsToAdd: [
      # babel 原值（not in core, added in babel）
      "ANTI"
      "DISCARD"
      "IF"
      "PLANS"
      "SEED"
      "SEMI"
      "SEQUENCES"
      "TEMP"
      # babel 原值（reserved in core, not reserved in babel）
      "ABS"
      "ABSOLUTE"
      "ACTION"
      "ADD"
      "AFTER"
      "ALL"
      "ALLOCATE"
      "ALLOW"
      "ALTER"
      "AND"
#     "ANY"
      "ARE"
      "ARRAY"
#     "ARRAY_AGG" # not a keyword in Calcite
      "ARRAY_MAX_CARDINALITY"
      "AS"
      "ASC"
      "ASENSITIVE"
      "ASSERTION"
      "ASYMMETRIC"
      "AT"
      "ATOMIC"
      "AUTHORIZATION"
