{"version":1,"savedAt":1790266563267,"rules":[{"id":"SQLI_TAUTOLOGY","name":"永真条件注入","description":"检测 OR 1=1 / OR 'a'='a' 等永真条件——注入测试与绕过认证的典型载荷。","kind":"BUILT_IN","category":"SQLI","severity":"CRITICAL","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_UNION","name":"UNION 注入探测","description":"检测 UNION [ALL] SELECT 组合查询——用于拼接额外结果集窃取数据。","kind":"BUILT_IN","category":"SQLI","severity":"CRITICAL","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_STACKED","name":"堆叠语句注入","description":"检测分号后追加第二条语句（UPDATE/DROP/GRANT 等）——构造异常语句的直接信号。","kind":"BUILT_IN","category":"SQLI","severity":"CRITICAL","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_COMMENT","name":"注释截断注入","description":"检测引号后接 --/#//* 等注释截断模式——用于吞掉原语句尾部实现注入。","kind":"BUILT_IN","category":"SQLI","severity":"HIGH","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_TIME_BASED","name":"延时盲注","description":"检测 pg_sleep / sleep / benchmark / waitfor delay——基于时间侧信道的盲注。","kind":"BUILT_IN","category":"SQLI","severity":"CRITICAL","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_META_PROBE","name":"元数据探测","description":"检测 information_schema / pg_catalog / mysql.user 等系统对象访问——库表结构踩点。","kind":"BUILT_IN","category":"SQLI","severity":"HIGH","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SQLI_OBFUSCATION","name":"混淆载荷","description":"检测长十六进制字面量、CHR() 编码链、空串 '||' 拼接等绕过特征。","kind":"BUILT_IN","category":"SQLI","severity":"HIGH","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SENSITIVE_BURST","name":"敏感列高频访问","description":"同一主体在滑动窗口内访问敏感列达到阈值——异常多次查询/拖库前兆。","kind":"BUILT_IN","category":"BEHAVIOR","severity":"HIGH","enabled":true,"params":{"sensitivityLevel":"MEDIUM","count":10,"windowSeconds":60},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"FAILURE_BURST","name":"失败风暴（探测/枚举）","description":"同一主体在滑动窗口内连续失败达到阈值——通常是扫描器、枚举或攻击工具。","kind":"BUILT_IN","category":"BEHAVIOR","severity":"HIGH","enabled":true,"params":{"count":5,"windowSeconds":60},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"OFF_HOURS_ACCESS","name":"非工作时间访问","description":"事件发生在配置的业务时段之外——合规审计信号，结合其他命中可升级为攻击。","kind":"BUILT_IN","category":"COMPLIANCE","severity":"MEDIUM","enabled":true,"params":{"startHour":8,"endHour":19},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"LARGE_RESULT","name":"大结果集拉取","description":"单次查询返回行数超过阈值——批量数据外泄信号（消费 QUERY 事件的 rowCount）。","kind":"BUILT_IN","category":"DATA_EXPOSURE","severity":"MEDIUM","enabled":true,"params":{"thresholdRows":1000},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"SELECT_STAR_SENSITIVE","name":"敏感表全列拉取","description":"SELECT * 命中含敏感列的表——绕过最小列集合的大范围暴露。","kind":"BUILT_IN","category":"DATA_EXPOSURE","severity":"MEDIUM","enabled":true,"params":{},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"MASK_BYPASS","name":"敏感列未脱敏直出","description":"触碰高敏列但管道报告 masked=false——脱敏策略缺口或人为旁路，数据明文出站。","kind":"BUILT_IN","category":"DATA_EXPOSURE","severity":"HIGH","enabled":true,"params":{"sensitivityLevel":"HIGH"},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"NEW_SUBJECT_SENSITIVE","name":"新主体首访高敏列","description":"用户首次访问某个高敏列（UEBA 基线）——单独低风险，作为关联分析的输入。","kind":"BUILT_IN","category":"BEHAVIOR","severity":"LOW","enabled":true,"params":{"sensitivityLevel":"HIGH"},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"},{"id":"BEHAVIOR_BASELINE","name":"UEBA 行为基线偏离","description":"对比个人行为画像（访问频率/惯常时段/结果集规模，自动从历史学习）：突发高频、异常大结果集、首次出现于陌生时段时命中。历史样本不足的用户不参与判定（冷启动保护）。","kind":"BUILT_IN","category":"BEHAVIOR","severity":"MEDIUM","enabled":true,"params":{"hourMinHistory":30,"rowCountMultiplier":5,"rowCountSamplesMin":10,"rateMultiplier":5,"burstFloor":8,"minHistoryEvents":20,"deviationWindowMinutes":10},"spec":null,"createdAt":"2026-09-24T05:36:59.079887600Z","updatedAt":"2026-09-24T05:36:59.079887600Z"}],"alerts":[],"sensitiveColumns":[{"columnKey":"crm.public.customer.id_card","sensitivity":"HIGH","category":"IDENTITY","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.customer.bank_card","sensitivity":"HIGH","category":"FINANCE","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.customer.phone","sensitivity":"HIGH","category":"CONTACT","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.customer.email","sensitivity":"MEDIUM","category":"CONTACT","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.customer.address","sensitivity":"MEDIUM","category":"LOCATION","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.customer.name","sensitivity":"MEDIUM","category":"PII","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.orders.pay_account","sensitivity":"HIGH","category":"FINANCE","enabled":true,"source":"SEEDED"},{"columnKey":"crm.public.orders.amount","sensitivity":"LOW","category":"FINANCE","enabled":true,"source":"SEEDED"}],"baseline":{},"events":[],"eventSeq":0,"alertSeq":0}